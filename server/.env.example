PORT=5001

# MongoDB Atlas (recommended) — see docs/MONGODB_ATLAS.md
# Replace USER, PASSWORD, and cluster host with your Atlas values.
# Database name must be: shadownet
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/shadownet?retryWrites=true&w=majority

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# Google Gemini (free tier) — AI narratives & attack simulation
GEMINI_API_KEY=

# Optional free TI keys (app works without them; crt.sh, DNS, OpenPhish, PhishTank need no key)
ALIENVAULT_OTX_KEY=
ABUSEIPDB_API_KEY=
VIEWDNS_API_KEY=
CRIMINALIP_API_KEY=
ZOOMEYE_API_KEY=
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
HYBRID_ANALYSIS_API_KEY=

# NVD (optional — works without key; register at nvd.nist.gov/developers for higher limits)
NVD_API_KEY=af23bae4-5b3e-497a-a550-618f4cb3caa0

# RIPEstat — no key required (wired automatically)
