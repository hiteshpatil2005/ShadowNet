# ═══════════════════════════════════════════════════
#  ShadowNet — Root .gitignore
#  NEVER commit real credentials to version control.
# ═══════════════════════════════════════════════════

# ── Node dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment & secrets ─────────────────────────
# Block ALL .env variants everywhere in the repo
.env
.env.*
!.env.example      # allow only the example/template file
**/.env
**/.env.*
!**/.env.example

# Extra safety — common secret file names
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/

# ── Build output ───────────────────────────────────
client/dist/
dist/
dist-ssr/
build/
.next/
out/

# ── Logs ───────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Coverage / test artefacts ──────────────────────
coverage/
.nyc_output/

# ── OS artefacts ───────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor / IDE ───────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.local

# ── Misc ───────────────────────────────────────────
*.tgz
*.zip
